# Det här skrivs åt dig av setup.js första gången du startar HEIMDALL.
# Vill du ändra något: öppna filen .env (inte den här) i Anteckningar.

# Gratis nyckel från https://aistudio.google.com/apikey
GEMINI_API_KEY=klistra-in-din-nyckel-här
# Valfritt: en nyckel till från ett annat Google-projekt = dubbelt så mycket gratis AI
# GEMINI_API_KEY_2=

# Din åtkomstkod till appen (hitta på en lång kod)
HEIMDALL_TOKEN=byt-till-en-lång-hemlig-kod
PORT=4777

# Molnet (Render) — sätt när du gjort steg 7 i README, så kopplar datorn upp sig mot molnet
# CLOUD_URL=https://heimdall-xxxx.onrender.com

# Valfritt: reserv-AI när Gemini tar slut (gratis på https://console.groq.com)
# GROQ_API_KEY=

# Valfritt: mejlkoll. Ett konto per rad: server|adress|app-lösenord|993|filter
# filter: tomt = notis vid mejl från riktiga människor, tips = bara tips/förfrågningar, svar = agenten skriver svarsförslag
# MAIL_JOBB=imap.gmail.com|du@gmail.com|abcd efgh ijkl mnop|993|svar

# Valfritt: n8n-automationer
# N8N_URL=https://dittnamn.app.n8n.cloud
# N8N_API_KEY=

# Valfritt: din mejladress för notiser till mobilen
# VAPID_EMAIL=du@exempel.se
